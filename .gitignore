# ============================================================
#  Python 虚拟环境（体积巨大，用 requirements.txt 重建）
# ============================================================
.venv/
venv/
env/
ENV/

# ============================================================
#  Python 缓存 / 测试缓存
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ============================================================
#  IDE / 编辑器
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ============================================================
#  操作系统垃圾文件
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
# 手动备份文件（如 viz/core.py.before_cairo_fix_*.bak）
*.bak

# ============================================================
#  LaTeX 编译辅助产物（保留 main.pdf 成品）
#  main.tex 编译时会生成这些中间文件，无需入库
# ============================================================
*.aux
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.blg
*.bbl
*.brf
*.nlo
*.nav
*.snm
*.vrb
*.idx
*.ilg
*.ind
*.dvi
# latexmk 自动生成的 .log 忽略，但 audit/ 下的编译日志保留
*.log
!audit/*.log

# ============================================================
#  运行时临时文件
# ============================================================
*.tmp
*.temp
*.pid

# ============================================================
#  中间过程图：experiment/results/figures/
#  这是求解时自动生成的诊断图（约 28MB / 441 张），
#  最终论文使用的是顶层 figures/ 里重绘后的图。
#  重新运行 src/paper_figures.py 即可再生成。
#  若想把结果快照也入库，删除下面这行即可。
# ============================================================

# ============================================================
#  直接上传包/*.zip 是交付压缩包（约 17.6MB），
#  可用 package_delivery.py 从工程重新打包生成。
#  默认忽略以减小仓库体积；若想把成品 zip 也入库，
#  删除下面两行的注释即可。
# ============================================================
# 直接上传包/*.zip
